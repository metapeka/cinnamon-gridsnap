__pycache__/
*.pyc
*.orig
*.bak
dist/
build/

# артефакты сборки штатного пакета debian/ (dpkg-buildpackage)
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/*.substvars
debian/gridsnap/
debian/tmp/

# сборка каталогов переводов (make mo); в репозитории лежат только .po и .pot
locale/

# сборка man-страниц (make man): в репозитории лежат исходник и каталоги po4a
man/build/

# резервные копии msgmerge (создаются при обновлении каталогов)
*.po~

# профили раскладок живого чекаута (`zone-tiler.py profile save` кладёт их рядом
# с zones.conf); в репозитории их нет — это данные владельца, а не поставка
templates/

# служебные файлы сессии omp/handoff-supervisor
.omp-handoff-session.json
.omp-handoff-supervisor.lock/
