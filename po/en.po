msgstr "zone-tiler: move - specify a direction: {directions}"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: не удалось прочитать рамку окна 0x{window:x}: {error}"
msgstr "zone-tiler: failed to read the frame of window 0x{window:x}: {error}"

#: zone-tiler.py
#, python-brace-format
