msgstr ""
"plan: run {argv} and put its window in zone '{zone}': x={x} y={y} {w}x{h} "
"(windows in the zone: {count} + 1)"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: терминал в зоне '{zone}' не появился за {seconds:g} с — окно не "
"найдено"
msgstr ""
"zone-tiler: the terminal in zone '{zone}' did not appear within {seconds:g} "
