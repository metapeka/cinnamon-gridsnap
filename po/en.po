#: zone-tiler.py
#, python-brace-format
msgid ""
"режим «только эта зона»: окно {window} -> зона '{zone}', свёрнуто окон — "
"{count}"
msgstr ""
"focus mode: window {window} -> zone '{zone}', windows minimized - {count}"

