#: gridsnap-ctl
msgid "gridsnap-ctl: для apply укажите зону, например: apply main"
msgstr "gridsnap-ctl: specify a zone for apply, for example: apply main"

#: gridsnap-ctl
msgid "gridsnap-ctl: у focus нет --monitor: режим берёт монитор целевого окна"
msgstr ""
"gridsnap-ctl: focus takes no --monitor: the mode uses the target window's "
"monitor"

#: gridsnap-ctl
msgid "gridsnap-ctl: у focus либо зона, либо --off, а не оба сразу"
msgstr "gridsnap-ctl: focus takes either a zone or --off, not both"

#: gridsnap-ctl
#, python-brace-format
msgid "gridsnap-ctl: у команды {command} нет зоны/окна/монитора"
msgstr "gridsnap-ctl: command {command} has no zone/window/monitor"

#: gridsnap-ctl
msgid "Управление демоном GridSnap через локальный IPC-сокет"
msgstr "Control the GridSnap daemon over a local IPC socket"

#: gridsnap-ctl
msgid ""
"Примеры: gridsnap-ctl status; gridsnap-ctl apply main; gridsnap-ctl focus "
"main; gridsnap-ctl focus --off; gridsnap-ctl quit"
msgstr ""
"Examples: gridsnap-ctl status; gridsnap-ctl apply main; gridsnap-ctl focus "
"main; gridsnap-ctl focus --off; gridsnap-ctl quit"

#: gridsnap-ctl
msgid ""
"status — состояние; apply — вложить окно в зону; focus — режим «только эта "
"зона»; reload — перечитать конфиг; quit — выйти"
msgstr ""
"status - state; apply - place the window in a zone; focus - focus mode; "
"reload - re-read the config; quit - exit"

#: gridsnap-ctl
msgid "имя зоны для apply и focus (у focus необязательна)"
msgstr "zone name for apply and focus (optional for focus)"

#: gridsnap-ctl
msgid "id окна для apply и focus (по умолчанию активное окно)"
msgstr "window id for apply and focus (the active window by default)"

#: gridsnap-ctl
msgid "номер монитора для apply"
msgstr "monitor index for apply"

#: gridsnap-ctl
msgid "focus: выйти из режима «только эта зона»"
msgstr "focus: leave focus mode"

#: gridsnap-ctl
msgid "путь UNIX-сокета (по умолчанию $XDG_RUNTIME_DIR/gridsnap/daemon.sock)"
msgstr "UNIX socket path ($XDG_RUNTIME_DIR/gridsnap/daemon.sock by default)"

#: gridsnap-ctl
msgid "печатать ответ одной строкой"
msgstr "print the answer on one line"

#: gridsnap-ctl
msgid "ничего не печатать при успехе"
msgstr "print nothing on success"

