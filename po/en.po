msgstr "plan: raise window 0x{window:x} of zone '{zone}' (tabs: {ring})"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: окно зоны '{zone}' — 0x{window:x}"
msgstr "zone-tiler: window of zone '{zone}' - 0x{window:x}"

