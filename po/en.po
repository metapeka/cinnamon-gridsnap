#, python-brace-format
msgid ""
"zone-tiler: зоны '{zone}' нет ни в наборе монитора '{monitor}', ни в [zones]"
msgstr ""
"zone-tiler: zone '{zone}' is in neither monitor set '{monitor}' nor [zones]"

