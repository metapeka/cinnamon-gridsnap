msgid "zone-tiler: в zones.conf нет ни одной зоны в секции [zones]"
msgstr "zone-tiler: no zones in section [zones] of zones.conf"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: правило '{selector}' ссылается на неизвестную зону '{zone}'"
msgstr "zone-tiler: rule '{selector}' refers to unknown zone '{zone}'"

