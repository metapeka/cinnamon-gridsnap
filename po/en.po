#, python-brace-format
msgid "zone-tiler: зоны '{zone}' нет в [zones] и ни в одном наборе мониторов"
msgstr "zone-tiler: zone '{zone}' is not in [zones] and not in any monitor set"

#: zone-tiler.py
msgid "zone-tiler: последняя линия в cols/rows должна быть 1.0"
msgstr "zone-tiler: the last line in cols/rows must be 1.0"

#: zone-tiler.py
msgid "zone-tiler: линии в cols/rows должны возрастать"
msgstr "zone-tiler: lines in cols/rows must increase"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: зона '{name}' должна быть 'c0:c1, r0:r1' или 'x,y,w,h'"
msgstr "zone-tiler: zone '{name}' must be 'c0:c1, r0:r1' or 'x,y,w,h'"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: зона '{name}' выходит за сетку ({ncols} колонок, {nrows} строк)"
msgstr ""
"zone-tiler: zone '{name}' goes beyond the grid ({ncols} columns, {nrows} "
"rows)"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: зона '{name}' выходит за пределы экрана (доли 0..1)"
msgstr "zone-tiler: zone '{name}' goes beyond the screen (fractions 0..1)"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: не удалось прочитать рамку окна 0x{window:x}: {error} — беру "
"первый экран"
msgstr ""
"zone-tiler: failed to read the frame of window 0x{window:x}: {error} - using "
"the first monitor"

#: zone-tiler.py
#, python-brace-format
msgid ""
"неверный рабочий стол '{text}': нужен номер стола (0, 1, …), {current} или "
"{conf}"
msgstr ""
"invalid workspace '{text}': a workspace number (0, 1, ...), {current} or "
"{conf} is required"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: профиля «{profile}» нет на диске: экран {output} раскладывается "
"без него: беру набор стола или общий"
msgstr ""
"zone-tiler: profile \"{profile}\" is not on disk: monitor {output} is laid "
"out without it: using the workspace set or the default one"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: профиля «{profile}» нет на диске: экран окна раскладывается без "
"него: беру набор стола или общий"
msgstr ""
"zone-tiler: profile \"{profile}\" is not on disk: the window's monitor is "
"laid out without it: using the workspace set or the default one"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: нет зоны '{zone}' в сетке экрана {output} (профиль «{profile}»). "
"Есть: {known}"
msgstr ""
"zone-tiler: no zone '{zone}' in the grid of monitor {output} (profile "
"\"{profile}\"). Known: {known}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: нет зоны '{zone}' в сетке стола {workspace} (профиль "
"«{profile}»). Есть: {known}"
msgstr ""
"zone-tiler: no zone '{zone}' in the grid of workspace {workspace} (profile "
"\"{profile}\"). Known: {known}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: нет зоны '{zone}' в сетке профиля «{profile}». Есть: {known}"
msgstr ""
"zone-tiler: no zone '{zone}' in the grid of profile \"{profile}\". Known: "
"{known}"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: нет зоны '{zone}' в [zones]. Есть: {known}"
msgstr "zone-tiler: no zone '{zone}' in [zones]. Known: {known}"

#: zone-tiler.py
msgid "zone-tiler: не удалось определить рабочую область экрана"
msgstr "zone-tiler: failed to determine the work area of the monitor"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: монитора '{monitor}' нет. Доступны: {available}"
msgstr "zone-tiler: no monitor '{monitor}'. Available: {available}"

#: zone-tiler.py zone-picker.py
msgid "нет"
msgstr "none"

#: zone-tiler.py
msgid "zone-tiler: xprop не найден (пакет x11-utils)"
msgstr "zone-tiler: xprop not found (x11-utils package)"

#: zone-tiler.py
msgid "zone-tiler: нет активного окна"
msgstr "zone-tiler: no active window"

#: zone-tiler.py
msgid "zone-tiler: не удалось подключиться к X-серверу (DISPLAY)"
msgstr "zone-tiler: failed to connect to the X server (DISPLAY)"

#: zone-tiler.py
#, python-brace-format
msgid "окно 0x{window:x} -> свёрнуто"
msgstr "window 0x{window:x} -> minimized"

