"zone-tiler: окна зон '{zone}' и '{partner}' обменяны (окон в зонах: {here} и "
"{there})"
msgstr ""
"zone-tiler: windows of zones '{zone}' and '{partner}' swapped (windows in "
"zones: {here} and {there})"

#: zone-tiler.py
msgid "пустая зона"
msgstr "empty zone"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: у действия '{name}' нет зоны — задайте zone в [action:{name}]"
msgstr "zone-tiler: action '{name}' has no zone - set zone in [action:{name}]"

#: zone-tiler.py
#, python-brace-format
