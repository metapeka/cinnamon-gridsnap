#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: не разобрать конфиг {path}: {error}"
msgstr "zone-tiler: cannot parse config {path}: {error}"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: не найден конфиг {path}"
msgstr "zone-tiler: config not found: {path}"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: пустое имя монитора в секции [{section}]"
msgstr "zone-tiler: empty monitor name in section [{section}]"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: в секции [{section}] нет ни одной зоны"
msgstr "zone-tiler: section [{section}] has no zones"

#: zone-tiler.py
msgid ""
"zone-tiler: есть только секции [zones:<выход>], а обязательной [zones] нет; "
"[zones] задаёт набор зон по умолчанию"
msgstr ""
"zone-tiler: only [zones:<output>] sections exist, but the required [zones] "
"is missing; [zones] defines the default zone set"

