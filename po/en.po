#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: окно 0x{window:x} под исключением ([ignore]/служебный тип) — "
"режим не включаю"
msgstr ""
"zone-tiler: window 0x{window:x} is excluded ([ignore]/utility window type) - "
