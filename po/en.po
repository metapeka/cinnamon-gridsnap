#, python-brace-format
msgid "zone-tiler: не удалось сохранить историю: {error}"
msgstr "zone-tiler: failed to save history: {error}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"рабочая область монитора {index}: {x},{y} {w}x{h}  (профиль «{profile}»)"
msgstr "monitor {index} work area: {x},{y} {w}x{h}  (profile \"{profile}\")"

#: zone-tiler.py
#, python-brace-format
msgid "рабочая область монитора {index}: {x},{y} {w}x{h}"
msgstr "monitor {index} work area: {x},{y} {w}x{h}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"рабочая область монитора {index}: {x},{y} {w}x{h}  (выход {output})  "
"(профиль «{profile}»)"
msgstr ""
"monitor {index} work area: {x},{y} {w}x{h}  (output {output})  (profile "
"\"{profile}\")"

#: zone-tiler.py
#, python-brace-format
msgid "рабочая область монитора {index}: {x},{y} {w}x{h}  (выход {output})"
msgstr "monitor {index} work area: {x},{y} {w}x{h}  (output {output})"

