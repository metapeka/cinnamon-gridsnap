msgid "окно вне зон — показывать нечего"
msgstr "the window is outside zones - nothing to show"

#: zone-tiler.py
#, python-brace-format
msgid "зона '{zone}' пуста — показывать нечего"
msgstr "zone '{zone}' is empty - nothing to show"

