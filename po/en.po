#, python-brace-format
msgid "zone-tiler: не удалось запустить действие: {error}"
msgstr "zone-tiler: failed to run the action: {error}"

#: zone-tiler.py
#, python-brace-format
msgid "план: argv = {argv}"
msgstr "plan: argv = {argv}"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: действие '{name}' запущено: {command}"
msgstr "zone-tiler: action '{name}' started: {command}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"план: окно {window} -> зону '{zone}', остальные окна стола и монитора — "
"свёрнуты (повторное нажатие вернёт)"
