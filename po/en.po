#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: окно 0x{window:x} под исключением ([ignore]/служебный тип) — не "
"двигаю"
msgstr ""
"zone-tiler: window 0x{window:x} is excluded ([ignore]/utility window type) - "
"not moving it"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: демон не ответил за {timeout:g} с — режим не переключаю "
"(работающего демона нельзя обойти снаружи)"
msgstr ""
"zone-tiler: the daemon did not answer within {timeout:g} s - not switching "
"the mode (a running daemon cannot be bypassed from outside)"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: демон ответил непонятно: {error}"
msgstr "zone-tiler: the daemon gave an unclear answer: {error}"

#: zone-tiler.py
msgid ""
"zone-tiler: демон не запущен — вкладки в зоне переключает он (запустите "
"gridsnap-daemon)"
msgstr ""
"zone-tiler: the daemon is not running - it switches tabs in a zone (start "
"gridsnap-daemon)"

#: zone-tiler.py zone-tabstrip.py
msgid "причина не названа"
msgstr "reason not given"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: демон отказал: {reason}"
msgstr "zone-tiler: the daemon refused: {reason}"

#: zone-tiler.py
msgid "zone-tiler: переключать нечего — в зоне активного окна одно окно"
msgstr ""
"zone-tiler: nothing to switch - the zone of the active window has a single "
"window"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: следующее окно зоны — {window}"
msgstr "zone-tiler: next window of the zone - {window}"

#: zone-tiler.py
msgid ""
"zone-tiler: action — укажите имя действия, например: zone-tiler.py action "
"mirror"
msgstr ""
"zone-tiler: action - specify an action name, for example: zone-tiler.py "
"action mirror"

#: zone-tiler.py
msgid "ни одного"
msgstr "none"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: нет действия '{name}'. Есть: {known}"
msgstr "zone-tiler: no action '{name}'. Known: {known}"

#: zone-tiler.py
