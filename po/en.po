msgstr "xwininfo: no field '{label}'"

#: zone-tiler.py
#, python-brace-format
msgid "окно 0x{window:x} -> зона '{zone}': x={x} y={y} {w}x{h}"
msgstr "window 0x{window:x} -> zone '{zone}': x={x} y={y} {w}x{h}"

#: zone-tiler.py
#, python-brace-format
msgid "окно 0x{window:x} -> зона: x={x} y={y} {w}x{h}"
msgstr "window 0x{window:x} -> zone: x={x} y={y} {w}x{h}"

