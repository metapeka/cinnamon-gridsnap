#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: {error}"
msgstr "zone-tiler: {error}"

#: zone-tiler.py
msgid "демон отклонил focus"
msgstr "the daemon rejected focus"

#: zone-tiler.py
#, python-brace-format
msgid "режим «только эта зона» выключен: развёрнуто окон — {count}"
msgstr "focus mode off: windows unminimized - {count}"

#: zone-tiler.py
#, python-brace-format
