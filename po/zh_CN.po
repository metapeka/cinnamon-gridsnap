#: zone-tiler.py
msgid "Window layout across grid zones (Cinnamon/X11)"
msgstr "按网格区域平铺窗口（Cinnamon/X11）"

#: zone-tiler.py
msgid "Examples: zone-tiler.py arrange --by order; zone-tiler.py stack main; zone-tiler.py tabs-next; zone-tiler.py undo --all; zone-tiler.py action mirror; zone-tiler.py profile use work; zone-tiler.py profile use-monitors"
msgstr "示例：zone-tiler.py arrange --by order; zone-tiler.py stack main; zone-tiler.py tabs-next; zone-tiler.py undo --all; zone-tiler.py action mirror; zone-tiler.py profile use work; zone-tiler.py profile use-monitors"

#: zone-tiler.py
msgid "list/apply/keys - as before; move - throw the window into the neighbouring zone; focus - focus mode (window into a zone, the rest minimized; repeat to leave); action - run an action from [action:<name>] (built-in or a custom command); arrange - lay windows out across zones; stack - gather windows into a zone as tabs; tabs-next - raise the next tab of the zone ([tabs] key); undo - restore frames from history; profile - your own layout profiles (zones + rules + keys)"
msgstr "list/apply/keys — 和以前一样；move — 把窗口挪到相邻区域；focus — 「只留这个区域」模式（窗口进区域，其余最小化；再按一次退出）；action — 执行 [action:<名称>] 里的操作（内置的或自己的命令）；arrange — 把窗口分配到各区域；stack — 把区域内的窗口收成标签页；tabs-next — 升起区域的下一个标签页（[tabs] 键）；undo — 从历史还原边框；profile — 自己的布局方案（区域 + 规则 + 按键）"

#: zone-tiler.py
msgid "zone name for apply/stack, direction for move, or a profile action"
msgstr "apply/stack 的区域名、move 的方向或 profile 的操作"

#: zone-tiler.py
msgid "profile name or JSON file for profile import"
msgstr "方案名或 profile import 的 JSON 文件"

#: zone-tiler.py
msgid "profile export: file for JSON (without it and without --json - stdout)"
msgstr "profile export：JSON 的目标文件（都不给且没有 --json — 输出到 stdout）"

#: zone-tiler.py
msgid "monitor for list/apply/stack/move: output name (HDMI-1) or index (without the flag - the window's monitor for apply/stack/move, the first one for list)"
msgstr "list/apply/stack/move 的显示器：输出名（HDMI-1）或编号（不带标志 — apply/stack/move 用窗口所在显示器，list 用第一台）"

#: zone-tiler.py
msgid "workspace for list/apply/move/arrange/stack: number (EWMH, zero-based), current (the active workspace's grid - default) or conf (always the zones.conf grid, without workspace profiles)"
msgstr "list/apply/move/arrange/stack 的工作桌面：编号（EWMH，从零开始）、current（活动桌面的网格 — 默认）或 conf（始终用 zones.conf 的网格，不带桌面方案）"

#: zone-tiler.py
msgid "window id (the active one by default)"
msgstr "窗口 id（默认活动窗口）"

#: zone-tiler.py
msgid "arrange: window selection - rules and the rest (auto), rules only, or by order"
msgstr "arrange：窗口的选择 — 规则加其余（auto）、只按规则，或按顺序"

#: zone-tiler.py
msgid "undo: roll back the whole history, not just the last operation"
msgstr "undo：回滚整个历史，而不只是最后一次操作"

#: zone-tiler.py
msgid "profile use/use-monitors: do not register hotkeys after activation"
msgstr "profile use/use-monitors：激活后不注册快捷键"

#: zone-tiler.py
msgid "profile export/gallery: print JSON (export - to stdout instead of a file)"
msgstr "profile export/gallery：输出 JSON（export 输出到标准输出，而不是写文件）"

#: zone-tiler.py
msgid "NAME"
msgstr "名称"

#: zone-tiler.py
msgid "profile import/from-gallery: profile name (import defaults to the JSON one)"
msgstr "profile import/from-gallery：方案名称（import 默认取自 JSON）"

#: zone-tiler.py
msgid "only compute the frame (for profile use-monitors - show the config), changing nothing"
msgstr "只计算边框（profile use-monitors 时 — 显示配置），什么都不改"

#: zone-tiler.py
msgid "focus: explicitly leave focus mode (unminimize what the mode minimized)"
msgstr "focus：显式退出「只留这个区域」模式（还原被该模式最小化的窗口）"

#: zone-tiler.py
msgid "keys: shortcuts for moving to the neighbouring zone from the [move] section"
msgstr "keys：[move] 段里移动到相邻区域的快捷键"

#: zone-tiler.py
msgid "re-read the real geometry"
msgstr "重新读取实际几何"

#: zone-tiler.py
msgid "--offset removed: windows of one zone are no longer cascaded, they sit as tabs on a shared frame (switching - tabs-next)"
msgstr "--offset 已移除：同一区域的窗口不再级联错位，而是作为标签页站在同一范围内（切换 — tabs-next）"

#: zone-tiler.py
msgid "zone-tiler: specify a zone, for example: zone-tiler.py apply left"
msgstr "zone-tiler: 请指定区域，例如：zone-tiler.py apply left"

