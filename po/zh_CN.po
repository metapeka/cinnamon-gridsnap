#: gridsnap-ctl
msgid "gridsnap-ctl: specify a zone for apply, for example: apply main"
msgstr "gridsnap-ctl: apply 需要指定区域，例如：apply main"

#: gridsnap-ctl
msgid "gridsnap-ctl: focus takes no --monitor: the mode uses the target window's monitor"
msgstr "gridsnap-ctl: focus 没有 --monitor：模式使用目标窗口所在显示器"

#: gridsnap-ctl
msgid "gridsnap-ctl: focus takes either a zone or --off, not both"
msgstr "gridsnap-ctl: focus 要么给区域，要么给 --off，不能两个都要"

#: gridsnap-ctl
#, python-brace-format
msgid "gridsnap-ctl: command {command} has no zone/window/monitor"
msgstr "gridsnap-ctl: 命令 {command} 没有区域/窗口/显示器"

#: gridsnap-ctl
msgid "Control the GridSnap daemon over a local IPC socket"
msgstr "通过本地 IPC 套接字控制 GridSnap 守护进程"

#: gridsnap-ctl
msgid "Examples: gridsnap-ctl status; gridsnap-ctl apply main; gridsnap-ctl focus main; gridsnap-ctl focus --off; gridsnap-ctl quit"
msgstr "示例：gridsnap-ctl status; gridsnap-ctl apply main; gridsnap-ctl focus main; gridsnap-ctl focus --off; gridsnap-ctl quit"

#: gridsnap-ctl
msgid "status — state; apply — place the window in a zone; focus — \"this zone only\" mode; reload — re-read the config; quit — exit; watch — listen to events"
msgstr "status — 状态；apply — 把窗口放进区域；focus — 「只留这个区域」模式；reload — 重新读取配置；quit — 退出；watch — 监听事件"

#: gridsnap-ctl
msgid "zone name for apply and focus (optional for focus)"
msgstr "apply 和 focus 的区域名（focus 时可省略）"

#: gridsnap-ctl
msgid "window id for apply and focus (the active window by default)"
msgstr "apply 和 focus 的窗口 id（默认活动窗口）"

#: gridsnap-ctl
msgid "monitor index for apply"
msgstr "apply 的显示器编号"

#: gridsnap-ctl
msgid "focus: leave focus mode"
msgstr "focus：退出「只留这个区域」模式"

#: gridsnap-ctl
msgid "UNIX socket path ($XDG_RUNTIME_DIR/gridsnap/daemon.sock by default)"
msgstr "UNIX 套接字路径（默认 $XDG_RUNTIME_DIR/gridsnap/daemon.sock）"

#: gridsnap-ctl
msgid "print the answer on one line"
msgstr "用一行打印回应"

#: gridsnap-ctl
msgid "print nothing on success"
msgstr "成功时不打印任何内容"

#: gridsnap-ctl
msgid "gridsnap-ctl: watch takes no zone/window/monitor"
msgstr "gridsnap-ctl：watch 没有区域/窗口/显示器"

