#, python-brace-format
msgid "zone-tiler: zone '{name}' must be 'c0:c1, r0:r1' or 'x,y,w,h'"
msgstr "zone-tiler: 区域 '{name}' 应写成 'c0:c1, r0:r1' 或 'x,y,w,h'"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: zone '{name}' goes beyond the grid ({ncols} columns, {nrows} rows)"
