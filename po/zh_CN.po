#: zone-tiler.py
#, python-brace-format
msgid "invalid workspace '{text}': a workspace number (0, 1, ...), {current} or {conf} is required"
msgstr "错误的工作桌面 '{text}'：需要桌面编号（0、1、…）、{current} 或 {conf}"

