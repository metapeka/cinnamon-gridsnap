#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: не найден конфиг {path}"
msgstr "zone-tiler: 找不到配置 {path}"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: пустое имя монитора в секции [{section}]"
msgstr "zone-tiler: 段 [{section}] 里的显示器名为空"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: в секции [{section}] нет ни одной зоны"
msgstr "zone-tiler: 段 [{section}] 里没有任何区域"

#: zone-tiler.py
msgid ""
"zone-tiler: есть только секции [zones:<выход>], а обязательной [zones] нет; "
"[zones] задаёт набор зон по умолчанию"
msgstr ""
"zone-tiler: 只有 [zones:<输出>] 段，缺少必需的 [zones]；[zones] 给出默认的区"
"域集合"

#: zone-tiler.py
msgid "zone-tiler: в zones.conf нет ни одной зоны в секции [zones]"
msgstr "zone-tiler: zones.conf 的 [zones] 段里没有任何区域"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: правило '{selector}' ссылается на неизвестную зону '{zone}'"
msgstr "zone-tiler: 规则 '{selector}' 引用了未知区域 '{zone}'"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: зоны '{zone}' нет ни в наборе монитора '{monitor}', ни в [zones]"
msgstr "zone-tiler: 显示器 '{monitor}' 的集合和 [zones] 里都没有区域 '{zone}'"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: зоны '{zone}' нет в [zones] и ни в одном наборе мониторов"
msgstr "zone-tiler: [zones] 和任何显示器集合里都没有区域 '{zone}'"

#: zone-tiler.py
msgid "zone-tiler: последняя линия в cols/rows должна быть 1.0"
msgstr "zone-tiler: cols/rows 的最后一条分界线必须是 1.0"

#: zone-tiler.py
msgid "zone-tiler: линии в cols/rows должны возрастать"
msgstr "zone-tiler: cols/rows 里的分界线必须递增"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: зона '{name}' должна быть 'c0:c1, r0:r1' или 'x,y,w,h'"
msgstr "zone-tiler: 区域 '{name}' 应写成 'c0:c1, r0:r1' 或 'x,y,w,h'"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: зона '{name}' выходит за сетку ({ncols} колонок, {nrows} строк)"
msgstr "zone-tiler: 区域 '{name}' 超出网格（{ncols} 列、{nrows} 行）"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: зона '{name}' выходит за пределы экрана (доли 0..1)"
msgstr "zone-tiler: 区域 '{name}' 超出屏幕范围（比例 0..1）"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: не удалось прочитать рамку окна 0x{window:x}: {error} — беру "
"первый экран"
msgstr ""
"zone-tiler: 无法读取窗口 0x{window:x} 的边框：{error} — 改用第一台显示器"

#: zone-tiler.py
#, python-brace-format
msgid ""
"неверный рабочий стол '{text}': нужен номер стола (0, 1, …), {current} или "
"{conf}"
msgstr "错误的工作桌面 '{text}'：需要桌面编号（0、1、…）、{current} 或 {conf}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: профиля «{profile}» нет на диске: экран {output} раскладывается "
"без него: беру набор стола или общий"
msgstr ""
"zone-tiler: 磁盘上没有方案「{profile}」：显示器 {output} 不带它布局：改用桌面"
"方案或公共集合"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: профиля «{profile}» нет на диске: экран окна раскладывается без "
"него: беру набор стола или общий"
msgstr ""
"zone-tiler: 磁盘上没有方案「{profile}」：窗口所在显示器不带它布局：改用桌面方"
"案或公共集合"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: нет зоны '{zone}' в сетке экрана {output} (профиль «{profile}»). "
"Есть: {known}"
msgstr ""
"zone-tiler: 显示器 {output} 的网格（方案「{profile}」）里没有区域 '{zone}'。"
"已有：{known}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: нет зоны '{zone}' в сетке стола {workspace} (профиль "
"«{profile}»). Есть: {known}"
msgstr ""
"zone-tiler: 桌面 {workspace} 的网格（方案「{profile}」）里没有区域 '{zone}'。"
"已有：{known}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: нет зоны '{zone}' в сетке профиля «{profile}». Есть: {known}"
msgstr "zone-tiler: 方案「{profile}」的网格里没有区域 '{zone}'。已有：{known}"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: нет зоны '{zone}' в [zones]. Есть: {known}"
msgstr "zone-tiler: [zones] 里没有区域 '{zone}'。已有：{known}"

#: zone-tiler.py
msgid "zone-tiler: не удалось определить рабочую область экрана"
msgstr "zone-tiler: 无法确定显示器的工作区"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: монитора '{monitor}' нет. Доступны: {available}"
msgstr "zone-tiler: 没有显示器 '{monitor}'。可用：{available}"

#: zone-tiler.py zone-picker.py
msgid "нет"
msgstr "无"

#: zone-tiler.py
msgid "zone-tiler: xprop не найден (пакет x11-utils)"
msgstr "zone-tiler: 找不到 xprop（x11-utils 包）"

#: zone-tiler.py
msgid "zone-tiler: нет активного окна"
msgstr "zone-tiler: 没有活动窗口"

#: zone-tiler.py
msgid "zone-tiler: не удалось подключиться к X-серверу (DISPLAY)"
msgstr "zone-tiler: 无法连接 X 服务器（DISPLAY）"

#: zone-tiler.py
#, python-brace-format
msgid "окно 0x{window:x} -> свёрнуто"
msgstr "窗口 0x{window:x} -> 已最小化"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: не удалось сохранить историю: {error}"
msgstr "zone-tiler: 无法保存历史：{error}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"рабочая область монитора {index}: {x},{y} {w}x{h}  (профиль «{profile}»)"
msgstr "显示器 {index} 的工作区：{x},{y} {w}x{h}  （方案「{profile}」）"

#: zone-tiler.py
#, python-brace-format
msgid "рабочая область монитора {index}: {x},{y} {w}x{h}"
msgstr "显示器 {index} 的工作区：{x},{y} {w}x{h}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"рабочая область монитора {index}: {x},{y} {w}x{h}  (выход {output})  "
"(профиль «{profile}»)"
msgstr ""
"显示器 {index} 的工作区：{x},{y} {w}x{h}  （输出 {output}）  （方案"
"「{profile}」）"

#: zone-tiler.py
#, python-brace-format
msgid "рабочая область монитора {index}: {x},{y} {w}x{h}  (выход {output})"
msgstr "显示器 {index} 的工作区：{x},{y} {w}x{h}  （输出 {output}）"

#: zone-tiler.py
#, python-brace-format
msgid "xwininfo: нет поля '{label}'"
msgstr "xwininfo: 没有字段 '{label}'"

#: zone-tiler.py
#, python-brace-format
msgid "окно 0x{window:x} -> зона '{zone}': x={x} y={y} {w}x{h}"
msgstr "窗口 0x{window:x} -> 区域 '{zone}'：x={x} y={y} {w}x{h}"

#: zone-tiler.py
#, python-brace-format
msgid "окно 0x{window:x} -> зона: x={x} y={y} {w}x{h}"
msgstr "窗口 0x{window:x} -> 区域：x={x} y={y} {w}x{h}"

#: zone-tiler.py
#, python-brace-format
msgid "рамка по факту: x={x} y={y} {w}x{h} — совпало с зоной"
msgstr "实测边框：x={x} y={y} {w}x{h} — 与区域一致"

#: zone-tiler.py
#, python-brace-format
msgid "рамка по факту: x={x} y={y} {w}x{h} — не совпало!"
msgstr "实测边框：x={x} y={y} {w}x{h} — 与区域不一致！"

#: zone-tiler.py
#, python-brace-format
msgid "{zone}: x={x} y={y} {w}x{h} (монитор {index}: {output})"
msgstr "{zone}：x={x} y={y} {w}x{h}（显示器 {index}：{output}）"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: окно 0x{window:x} под исключением ([ignore]/служебный тип) — не "
"двигаю"
msgstr "zone-tiler: 窗口 0x{window:x} 属于例外（[ignore]/工具类窗口）— 不移动"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: демон не ответил за {timeout:g} с — режим не переключаю "
"(работающего демона нельзя обойти снаружи)"
msgstr ""
"zone-tiler: 守护进程在 {timeout:g} 秒内没有回应 — 不切换模式（运行中的守护进"
"程无法从外部绕过）"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: демон ответил непонятно: {error}"
msgstr "zone-tiler: 守护进程的回应无法理解：{error}"

#: zone-tiler.py
msgid ""
"zone-tiler: демон не запущен — вкладки в зоне переключает он (запустите "
"gridsnap-daemon)"
msgstr ""
"zone-tiler: 守护进程没有运行 — 区域内的标签页由它切换（请启动 gridsnap-"
"daemon）"

#: zone-tiler.py zone-tabstrip.py
msgid "причина не названа"
msgstr "未说明原因"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: демон отказал: {reason}"
msgstr "zone-tiler: 守护进程拒绝：{reason}"

#: zone-tiler.py
msgid "zone-tiler: переключать нечего — в зоне активного окна одно окно"
msgstr "zone-tiler: 没有可切换的窗口 — 活动窗口所在区域只有一个窗口"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: следующее окно зоны — {window}"
msgstr "zone-tiler: 区域的下一个窗口 — {window}"

#: zone-tiler.py
msgid ""
"zone-tiler: action — укажите имя действия, например: zone-tiler.py action "
"mirror"
msgstr "zone-tiler: action — 请指定操作名，例如：zone-tiler.py action mirror"

#: zone-tiler.py
msgid "ни одного"
msgstr "无"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: нет действия '{name}'. Есть: {known}"
msgstr "zone-tiler: 没有操作 '{name}'。已有：{known}"

#: zone-tiler.py
msgid "окна нет"
msgstr "没有窗口"

#: zone-tiler.py
#, python-brace-format
msgid "окно 0x{window:x}"
msgstr "窗口 0x{window:x}"

#: zone-tiler.py
msgid "вне зон"
msgstr "区域之外"

#: zone-tiler.py
#, python-brace-format
msgid "зона '{zone}'"
msgstr "区域 '{zone}'"

#: zone-tiler.py
msgid "экран не определён"
msgstr "显示器未确定"

#: zone-tiler.py zone-daemon.py
msgid "неизвестен"
msgstr "未知"

#: zone-tiler.py
#, python-brace-format
msgid ""
"действие '{name}' ({run}): {window} -> {where} (монитор {screen}, стол "
"{desk})"
msgstr ""
"操作 '{name}'（{run}）：{window} -> {where}（显示器 {screen}，桌面 {desk}）"

#: zone-tiler.py
#, python-brace-format
msgid "план: {message} — ничего не делаю"
msgstr "计划：{message} — 不做任何事"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: не удалось запустить действие: {error}"
msgstr "zone-tiler: 无法启动操作：{error}"

#: zone-tiler.py
#, python-brace-format
msgid "план: argv = {argv}"
msgstr "计划：argv = {argv}"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: действие '{name}' запущено: {command}"
msgstr "zone-tiler: 操作 '{name}' 已启动：{command}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"план: окно {window} -> зону '{zone}', остальные окна стола и монитора — "
"свёрнуты (повторное нажатие вернёт)"
msgstr ""
"计划：窗口 {window} -> 区域 '{zone}'，桌面和显示器上的其余窗口已最小化（再按"
"一次可还原）"

#: zone-tiler.py
#, python-brace-format
msgid ""
"план: окно {window} -> на месте, остальные окна стола и монитора — свёрнуты "
"(повторное нажатие вернёт)"
msgstr ""
"计划：窗口 {window} -> 留在原处，桌面和显示器上的其余窗口已最小化（再按一次可"
"还原）"

#: zone-tiler.py
msgid "окно вне зон — показывать нечего"
msgstr "窗口在区域之外 — 没有可显示的内容"

#: zone-tiler.py
#, python-brace-format
msgid "зона '{zone}' пуста — показывать нечего"
msgstr "区域 '{zone}' 是空的 — 没有可显示的内容"

#: zone-tiler.py
#, python-brace-format
msgid "план: поднять окно 0x{window:x} зоны '{zone}' (вкладки: {ring})"
msgstr "计划：升起区域 '{zone}' 的窗口 0x{window:x}（标签页：{ring}）"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: окно зоны '{zone}' — 0x{window:x}"
msgstr "zone-tiler: 区域的窗口 '{zone}' — 0x{window:x}"

#: zone-tiler.py
msgid "zone-tiler: окно вне зон — зеркалить нечего"
msgstr "zone-tiler: 窗口在区域之外 — 没有可镜像的内容"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: в этой сетке нет зеркальной зоны для '{zone}'"
msgstr "zone-tiler: 这个网格里没有 '{zone}' 的镜像区域"

#: zone-tiler.py
#, python-brace-format
msgid "зоны '{zone}' и '{partner}' пусты — обменивать нечего"
msgstr "区域 '{zone}' 和 '{partner}' 都是空的 — 没有可交换的内容"

#: zone-tiler.py
#, python-brace-format
msgid ""
"план: обмен зон '{zone}' и '{partner}' ({axis}): {here} -> '{partner}', "
"{there} -> '{zone}'; рамки x={hx} y={hy} {hw}x{hh} и x={tx} y={ty} {tw}x{th}"
msgstr ""
"计划：交换区域 '{zone}' 和 '{partner}'（{axis}）：{here} -> '{partner}'，"
"{there} -> '{zone}'；边框 x={hx} y={hy} {hw}x{hh} 和 x={tx} y={ty} {tw}x{th}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: окна зон '{zone}' и '{partner}' обменяны (окон в зонах: {here} и "
"{there})"
msgstr ""
"zone-tiler: 区域 '{zone}' 和 '{partner}' 的窗口已交换（区域内的窗口数："
"{here} 和 {there}）"

#: zone-tiler.py
msgid "пустая зона"
msgstr "空区域"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: у действия '{name}' нет зоны — задайте zone в [action:{name}]"
msgstr "zone-tiler: 操作 '{name}' 没有区域 — 请在 [action:{name}] 里给出 zone"

#: zone-tiler.py
#, python-brace-format
msgid ""
"план: запустить {argv} и положить его окно в зону '{zone}': x={x} y={y} {w}"
"x{h} (окон в зоне: {count} + 1)"
msgstr ""
"计划：运行 {argv} 并把它的窗口放进区域 '{zone}'：x={x} y={y} {w}x{h}（区域内"
"的窗口：{count} + 1）"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: терминал в зоне '{zone}' не появился за {seconds:g} с — окно не "
"найдено"
msgstr ""
"zone-tiler: 区域 '{zone}' 里的终端在 {seconds:g} 秒内没有出现 — 没有找到窗口"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: терминал в зоне '{zone}': окно 0x{window:x}"
msgstr "zone-tiler: 区域 '{zone}' 里的终端：窗口 0x{window:x}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: {count} окон развернуть не удалось — запись режима сохранена, "
"повторите focus --off"
msgstr ""
"zone-tiler: {count} 个窗口无法还原 — 模式记录已保存，请重复 focus --off"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: {error}"
msgstr "zone-tiler: {error}"

#: zone-tiler.py
msgid "демон отклонил focus"
msgstr "守护进程拒绝了 focus"

#: zone-tiler.py
#, python-brace-format
msgid "режим «только эта зона» выключен: развёрнуто окон — {count}"
msgstr "「只留这个区域」模式已关闭：已还原的窗口 — {count}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"режим «только эта зона»: держит демон (зона '{zone}', цель {window}, "
"свёрнуто {count}) — выключился бы"
msgstr ""
"「只留这个区域」：由守护进程保持（区域 '{zone}'，目标 {window}，已最小化 "
"{count}）— 会关闭"

#: zone-tiler.py zone-daemon.py
msgid "без зоны"
msgstr "无区域"

#: zone-tiler.py
#, python-brace-format
msgid "режим «только эта зона»: выключился бы, развернулось бы окон — {count}"
msgstr "「只留这个区域」：会关闭，会还原的窗口 — {count}"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: не удалось определить монитор окна 0x{window:x}"
msgstr "zone-tiler: 无法确定窗口 0x{window:x} 的显示器"

#: zone-tiler.py
#, python-brace-format
msgid ""
"режим «только эта зона»: окно 0x{window:x} -> зона '{zone}' x={x} y={y} {w}"
"x{h}, свернулось бы окон — {count}"
msgstr ""
"「只留这个区域」：窗口 0x{window:x} -> 区域 '{zone}' x={x} y={y} {w}x{h}，会"
"最小化的窗口 — {count}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"режим «только эта зона»: окно 0x{window:x} -> остаётся на месте, свернулось "
"бы окон — {count}"
msgstr ""
"「只留这个区域」：窗口 0x{window:x} -> 留在原处，会最小化的窗口 — {count}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"zone-tiler: окно 0x{window:x} под исключением ([ignore]/служебный тип) — "
"режим не включаю"
msgstr ""
"zone-tiler: 窗口 0x{window:x} 属于例外（[ignore]/工具类窗口）— 不开启模式"

#: zone-tiler.py
msgid "zone-tiler: не удалось определить активный рабочий стол"
msgstr "zone-tiler: 无法确定活动的工作桌面"

#: zone-tiler.py
#, python-brace-format
msgid "zone-tiler: не удалось записать состояние режима: {error}"
msgstr "zone-tiler: 无法写入模式状态：{error}"

#: zone-tiler.py
#, python-brace-format
msgid ""
"режим «только эта зона»: окно 0x{window:x} -> зона '{zone}', свёрнуто окон — "
"{count}"
msgstr ""
"「只留这个区域」：窗口 0x{window:x} -> 区域 '{zone}'，已最小化的窗口 — "
"{count}"

#: zone-tiler.py
#, python-brace-format
msgid "режим «только эта зона»: окно 0x{window:x}, свёрнуто окон — {count}"
