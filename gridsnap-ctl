#!/usr/bin/env python3
"""gridsnap-ctl — клиент IPC демона GridSnap (`zone-daemon.py`).

Говорит с локальным UNIX-сокетом демона: одна JSON-команда на соединение,
ответ — JSON-строка. Зависимостей нет — только стандартная библиотека и
чистый `zone_ipc.py` (кадрирование протокола).

    gridsnap-ctl status                     # состояние демона (зоны, окна, reflow)
    gridsnap-ctl apply main                 # вложить активное окно в зону main
    gridsnap-ctl apply main --window 0x1a00007
    gridsnap-ctl apply main --monitor 1
    gridsnap-ctl focus main                 # окно в зону main + свернуть остальные (toggle)
    gridsnap-ctl focus                      # свернуть всё, кроме активного окна
    gridsnap-ctl focus main --window 0x1a00007
    gridsnap-ctl focus --off                # выйти из режима
    gridsnap-ctl reload                     # демон перечитает zones.conf
    gridsnap-ctl quit                       # попросить демон завершиться
    gridsnap-ctl watch                      # подписаться и печатать события

`watch` — не команда-запрос: соединение остаётся открытым, демон шлёт в него по
строке JSON на событие (`window-appeared`/`window-closed`/`window-moved`,
`focus-on`/`focus-off`), а отписка — закрыть соединение (`Ctrl-C`). Строки
печатаются как есть — фильтровать и разбирать их можно снаружи (`jq`, `grep`).

Путь сокета — по умолчанию `$XDG_RUNTIME_DIR/gridsnap/daemon.sock`, как у
демона; переопределяется `--socket PATH` (тот же флаг у демона).

Коды возврата: 0 — успех, 1 — ошибка (нет демона, отказ команды),
2 — ошибка аргументов.
"""

import argparse
import json
import os
import socket
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

import zone_ipc  # noqa: E402  (ищем рядом с собой, как устанавливается)
from zone_i18n import _  # noqa: E402  (строки интерфейса — через каталог)

EXIT_OK = 0
EXIT_FAIL = 1
EXIT_USAGE = 2

VERSION = "0.2.0"

# Сколько ждать ответа демона, секунд.
TIMEOUT = 5.0


class _DevNull:
    """Приёмник, который ничего не печатает: `watch --quiet` без строки о подписке."""

    @staticmethod
    def write(_text):
        return 0

    @staticmethod
    def flush():
        return None


def send_command(request, path, timeout=TIMEOUT):
    """Отправить одну команду и вернуть ответ-dict.

    Райзит `OSError` (нет демона/сокета, обрыв) и `zone_ipc.ProtocolError`
    (битый ответ) — вызывающий печатает понятное сообщение.
    """
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(timeout)
    try:
        conn.connect(path)
        conn.sendall(zone_ipc.encode_message(request))
        return zone_ipc.read_response(conn)
    finally:
        conn.close()


def watch(path, stream=None, notice=None, timeout=TIMEOUT):
    """Подписаться на события демона и печатать их до обрыва или `Ctrl-C`.

    Подписка (`subscribe`) — единственная команда, после которой соединение
    только на чтение: демон шлёт по строке JSON на событие, отписка — закрыть
    соединение. Строки печатаются как есть и сразу (`flush`): `watch` и смотрят
    глазами, и служит подписчиком скриптам и дымовому тесту. Человеку — одна
    строка о подписке в `stderr`, чтобы поток в `stdout` оставался чистым.

    Возвращает код `EXIT_OK` или `EXIT_FAIL`; `KeyboardInterrupt` и закрытый
    приёмник (`gridsnap-ctl watch | head`) — не ошибка, а конец наблюдения.
    """
    stream = stream if stream is not None else sys.stdout
    notice = notice if notice is not None else sys.stderr
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        conn.settimeout(timeout)
        conn.connect(path)
        conn.sendall(zone_ipc.encode_message({"cmd": "subscribe"}))
        answer = zone_ipc.read_response(conn)
        if not answer.get("ok"):
            print(
                _("gridsnap-ctl: the daemon rejected the subscription: {error}").format(
                    error=answer.get("error", _("command rejected"))
                ),
                file=notice,
            )
            return EXIT_FAIL
        groups = ", ".join(str(g) for g in answer.get("subscribed") or [])
        print(
            _("gridsnap-ctl: subscribed ({groups}) — Ctrl-C to stop").format(
                groups=groups
            ),
            file=notice,
            flush=True,
        )
        conn.settimeout(None)  # события идут, когда захотят
        reader = zone_ipc.LineReader()
        while True:
            data = conn.recv(4096)
            if not data:  # демон закрыл соединение (завершился)
                tail = reader.tail().strip()
                if tail:
                    _print_event(tail, stream)
                return EXIT_OK
            for line in reader.feed(data):
                if line.strip():
                    _print_event(line, stream)
    except BrokenPipeError:  # приёмник закрылся: watch | head — не ошибка
        return EXIT_OK
    except zone_ipc.ProtocolError as exc:
        print(
            _("gridsnap-ctl: the daemon gave an unclear answer: {error}").format(error=exc),
            file=notice,
        )
        return EXIT_FAIL
    except OSError as exc:
        print(
            _(
                "gridsnap-ctl: no connection to the daemon over socket {path} ({error}). Is zone-daemon.py running?"
            ).format(path=path, error=exc),
            file=notice,
        )
        return EXIT_FAIL
    finally:
        conn.close()


def _print_event(line, stream):
    """Напечатать строку события как есть; битую — тоже (разберёт потребитель)."""
    text = line.decode("utf-8", "replace") if isinstance(line, bytes) else str(line)
    print(text, file=stream, flush=True)


def build_request(args):
    """Собрать запрос из аргументов CLI. Неверные сочетания -> `SystemExit(2)`."""
    request = {"cmd": args.command}
    if args.command == "apply":
        if not args.zone:
            print(_("gridsnap-ctl: specify a zone for apply, for example: apply main"), file=sys.stderr)
            raise SystemExit(EXIT_USAGE)
        request["zone"] = args.zone
        if args.window is not None:
            request["window"] = args.window
        if args.monitor is not None:
            request["monitor"] = args.monitor
    elif args.command == "focus":
        if args.monitor is not None:
            # Режим сворачивает окна того монитора, где лежит целевое окно:
            # чужой монитор в запросе ему не нужен.
            print(
                _("gridsnap-ctl: focus takes no --monitor: the mode uses the target window's monitor"),
                file=sys.stderr,
            )
            raise SystemExit(EXIT_USAGE)
        if args.off and args.zone:
            print(
                _("gridsnap-ctl: focus takes either a zone or --off, not both"),
                file=sys.stderr,
            )
            raise SystemExit(EXIT_USAGE)
        if args.off:
            request["off"] = True
        elif args.zone:
            request["zone"] = args.zone
        # Без зоны и без `--off` — «свернуть всё, кроме этого окна»: окно
        # остаётся на месте, в запросе нет ни `zone`, ни `off`.
        if args.window is not None:
            request["window"] = args.window
    elif args.zone or args.window is not None or args.monitor is not None:
        print(
            _("gridsnap-ctl: command {command} has no zone/window/monitor").format(
                command=args.command
            ),
            file=sys.stderr,
        )
        raise SystemExit(EXIT_USAGE)
    return request


def main(argv=None):
    ap = argparse.ArgumentParser(
        description=_("Control the GridSnap daemon over a local IPC socket"),
        epilog=_(
            "Examples: gridsnap-ctl status; gridsnap-ctl apply main; gridsnap-ctl focus main; gridsnap-ctl focus --off; gridsnap-ctl quit"
        ),
    )
    ap.add_argument(
        "command",
        choices=["status", "apply", "focus", "reload", "quit", "watch"],
        help=_(
            "status — state; apply — place the window in a zone; focus — \"this zone only\" mode; reload — re-read the config; quit — exit; watch — listen to events"
        ),
    )
    ap.add_argument(
        "zone",
        nargs="?",
        help=_("zone name for apply and focus (optional for focus)"),
    )
    ap.add_argument(
        "--window",
        type=lambda s: int(s, 0),
        help=_("window id for apply and focus (the active window by default)"),
    )
    ap.add_argument("--monitor", type=int, help=_("monitor index for apply"))
    ap.add_argument(
        "--off",
        action="store_true",
        help=_("focus: leave focus mode"),
    )
    ap.add_argument(
        "--socket",
        default=None,
        help=_("UNIX socket path ($XDG_RUNTIME_DIR/gridsnap/daemon.sock by default)"),
    )
    ap.add_argument("--raw", action="store_true", help=_("print the answer on one line"))
    ap.add_argument("--quiet", action="store_true", help=_("print nothing on success"))
    ap.add_argument("--version", action="version", version=f"gridsnap-ctl {VERSION}")
    args = ap.parse_args(argv)

    path = args.socket or zone_ipc.default_socket_path()
    if args.command == "watch":
        if args.zone or args.window is not None or args.monitor is not None or args.off:
            print(
                _("gridsnap-ctl: watch takes no zone/window/monitor"),
                file=sys.stderr,
            )
            return EXIT_USAGE
        try:
            return watch(path, notice=None if not args.quiet else _DevNull())
        except KeyboardInterrupt:
            return EXIT_OK

    request = build_request(args)
    try:
        response = send_command(request, path)
    except zone_ipc.ProtocolError as exc:
        print(_("gridsnap-ctl: the daemon gave an unclear answer: {error}").format(error=exc), file=sys.stderr)
        return EXIT_FAIL
    except OSError as exc:
        print(
            _(
                "gridsnap-ctl: no connection to the daemon over socket {path} ({error}). Is zone-daemon.py running?"
            ).format(path=path, error=exc),
            file=sys.stderr,
        )
        return EXIT_FAIL

    if not response.get("ok"):
        print(
            _("gridsnap-ctl: {error}").format(
                error=response.get("error", _("command rejected"))
            ),
            file=sys.stderr,
        )
        return EXIT_FAIL

    if not args.quiet:
        if args.raw:
            print(json.dumps(response, ensure_ascii=False))
        else:
            print(json.dumps(response, ensure_ascii=False, indent=2))
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
