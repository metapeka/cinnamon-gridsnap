#!/usr/bin/env python3
"""gridsnap-ctl — IPC client of the GridSnap daemon (`zone-daemon.py`).

Talks to the daemon's local UNIX socket: one JSON command per connection, the
answer is a JSON line. No dependencies — only the standard library and the
pure `zone_ipc.py` (protocol framing).

    gridsnap-ctl status                     # daemon state (zones, windows, reflow)
    gridsnap-ctl apply main                 # put the active window into the `main` zone
    gridsnap-ctl apply main --window 0x1a00007
    gridsnap-ctl apply main --monitor 1
    gridsnap-ctl focus main                 # the window into the `main` zone + minimize the rest (toggle)
    gridsnap-ctl focus                      # minimize everything except the active window
    gridsnap-ctl focus main --window 0x1a00007
    gridsnap-ctl focus --off                # leave the mode
    gridsnap-ctl reload                     # the daemon re-reads zones.conf
    gridsnap-ctl quit                       # ask the daemon to finish
    gridsnap-ctl watch                      # subscribe and print events

`watch` is not a request command: the connection stays open, the daemon sends one
JSON line per event (`window-appeared`/`window-closed`/`window-moved`,
`focus-on`/`focus-off`), and unsubscribing means closing the connection (`Ctrl-C`). The lines
are printed as they are — filter and parse them on the outside (`jq`, `grep`).

The socket path is `$XDG_RUNTIME_DIR/gridsnap/daemon.sock` by default, as for the
daemon; it is overridden by `--socket PATH` (the same flag on the daemon).

Return codes: 0 — success, 1 — a failure (no daemon, the command was refused),
2 — an argument error.
"""

import argparse
import json
import os
import socket
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

import zone_ipc  # noqa: E402  (looked for next to itself, as it is installed)
from zone_i18n import _  # noqa: E402  (interface strings come from the catalog)

EXIT_OK = 0
EXIT_FAIL = 1
EXIT_USAGE = 2

VERSION = "0.3.0"

# How long to wait for the daemon's answer, in seconds.
TIMEOUT = 5.0


class _DevNull:
    """A receiver that prints nothing: `watch --quiet` without the subscription line."""

    @staticmethod
    def write(_text):
        return 0

    @staticmethod
    def flush():
        return None


def send_command(request, path, timeout=TIMEOUT):
    """Send one command and return the answer dict.

    Raises `OSError` (no daemon/socket, a broken connection) and `zone_ipc.ProtocolError`
    (a broken answer) - the caller prints a readable message.
    """
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(timeout)
    try:
        conn.connect(path)
        conn.sendall(zone_ipc.encode_message(request))
        return zone_ipc.read_response(conn)
    finally:
        conn.close()


def watch(path, stream=None, notice=None, timeout=TIMEOUT):
    """Subscribe to the daemon's events and print them until the connection breaks or `Ctrl-C`.

    A subscription (`subscribe`) is the only command after which the connection is
    read-only: the daemon sends one JSON line per event, unsubscribing means closing
    the connection. The lines are printed as they are and at once (`flush`): `watch` both looks
    at them with your own eyes and serves as a subscriber for scripts and the smoke test. For a human - one
    line about the subscription on `stderr`, so that the stream on `stdout` stays clean.

    Returns `EXIT_OK` or `EXIT_FAIL`; `KeyboardInterrupt` and a closed
    receiver (`gridsnap-ctl watch | head`) are not an error but the end of watching.
    """
    stream = stream if stream is not None else sys.stdout
    notice = notice if notice is not None else sys.stderr
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        conn.settimeout(timeout)
        conn.connect(path)
        conn.sendall(zone_ipc.encode_message({"cmd": "subscribe"}))
        answer = zone_ipc.read_response(conn)
        if not answer.get("ok"):
            print(
                _("gridsnap-ctl: the daemon rejected the subscription: {error}").format(
                    error=answer.get("error", _("command rejected"))
                ),
                file=notice,
            )
            return EXIT_FAIL
        groups = ", ".join(str(g) for g in answer.get("subscribed") or [])
        print(
            _("gridsnap-ctl: subscribed ({groups}) — Ctrl-C to stop").format(
                groups=groups
            ),
            file=notice,
            flush=True,
        )
        conn.settimeout(None)  # events come whenever they want
        reader = zone_ipc.LineReader()
        while True:
            data = conn.recv(4096)
            if not data:  # the daemon closed the connection (it finished)
                tail = reader.tail().strip()
                if tail:
                    _print_event(tail, stream)
                return EXIT_OK
            for line in reader.feed(data):
                if line.strip():
                    _print_event(line, stream)
    except BrokenPipeError:  # the receiver closed: watch | head is not an error
        return EXIT_OK
    except zone_ipc.ProtocolError as exc:
        print(
            _("gridsnap-ctl: the daemon gave an unclear answer: {error}").format(error=exc),
            file=notice,
        )
        return EXIT_FAIL
    except OSError as exc:
        print(
            _(
                "gridsnap-ctl: no connection to the daemon over socket {path} ({error}). Is zone-daemon.py running?"
            ).format(path=path, error=exc),
            file=notice,
        )
        return EXIT_FAIL
    finally:
        conn.close()


def _print_event(line, stream):
    """Print an event line as it is; a broken one too (the consumer will parse it)."""
    text = line.decode("utf-8", "replace") if isinstance(line, bytes) else str(line)
    print(text, file=stream, flush=True)


def build_request(args):
    """Build the request from the CLI arguments. Bad combinations -> `SystemExit(2)`."""
    request = {"cmd": args.command}
    if args.command == "apply":
        if not args.zone:
            print(_("gridsnap-ctl: specify a zone for apply, for example: apply main"), file=sys.stderr)
            raise SystemExit(EXIT_USAGE)
        request["zone"] = args.zone
        if args.window is not None:
            request["window"] = args.window
        if args.monitor is not None:
            request["monitor"] = args.monitor
    elif args.command == "focus":
        if args.monitor is not None:
            # The mode minimizes the windows of the monitor the target window is on:
            # a foreign monitor is not needed in the request.
            print(
                _("gridsnap-ctl: focus takes no --monitor: the mode uses the target window's monitor"),
                file=sys.stderr,
            )
            raise SystemExit(EXIT_USAGE)
        if args.off and args.zone:
            print(
                _("gridsnap-ctl: focus takes either a zone or --off, not both"),
                file=sys.stderr,
            )
            raise SystemExit(EXIT_USAGE)
        if args.off:
            request["off"] = True
        elif args.zone:
            request["zone"] = args.zone
        # No zone and no `--off` - "minimize everything except this window": the window
        # stays where it is, the request has neither `zone` nor `off`.
        if args.window is not None:
            request["window"] = args.window
    elif args.zone or args.window is not None or args.monitor is not None:
        print(
            _("gridsnap-ctl: command {command} has no zone/window/monitor").format(
                command=args.command
            ),
            file=sys.stderr,
        )
        raise SystemExit(EXIT_USAGE)
    return request


def main(argv=None):
    ap = argparse.ArgumentParser(
        description=_("Control the GridSnap daemon over a local IPC socket"),
        epilog=_(
            "Examples: gridsnap-ctl status; gridsnap-ctl apply main; gridsnap-ctl focus main; gridsnap-ctl focus --off; gridsnap-ctl quit"
        ),
    )
    ap.add_argument(
        "command",
        choices=["status", "apply", "focus", "reload", "quit", "watch"],
        help=_(
            "status — state; apply — place the window in a zone; focus — \"this zone only\" mode; reload — re-read the config; quit — exit; watch — listen to events"
        ),
    )
    ap.add_argument(
        "zone",
        nargs="?",
        help=_("zone name for apply and focus (optional for focus)"),
    )
    ap.add_argument(
        "--window",
        type=lambda s: int(s, 0),
        help=_("window id for apply and focus (the active window by default)"),
    )
    ap.add_argument("--monitor", type=int, help=_("monitor index for apply"))
    ap.add_argument(
        "--off",
        action="store_true",
        help=_("focus: leave focus mode"),
    )
    ap.add_argument(
        "--socket",
        default=None,
        help=_("UNIX socket path ($XDG_RUNTIME_DIR/gridsnap/daemon.sock by default)"),
    )
    ap.add_argument("--raw", action="store_true", help=_("print the answer on one line"))
    ap.add_argument("--quiet", action="store_true", help=_("print nothing on success"))
    ap.add_argument("--version", action="version", version=f"gridsnap-ctl {VERSION}")
    args = ap.parse_args(argv)

    path = args.socket or zone_ipc.default_socket_path()
    if args.command == "watch":
        if args.zone or args.window is not None or args.monitor is not None or args.off:
            print(
                _("gridsnap-ctl: watch takes no zone/window/monitor"),
                file=sys.stderr,
            )
            return EXIT_USAGE
        try:
            return watch(path, notice=None if not args.quiet else _DevNull())
        except KeyboardInterrupt:
            return EXIT_OK

    request = build_request(args)
    try:
        response = send_command(request, path)
    except zone_ipc.ProtocolError as exc:
        print(_("gridsnap-ctl: the daemon gave an unclear answer: {error}").format(error=exc), file=sys.stderr)
        return EXIT_FAIL
    except OSError as exc:
        print(
            _(
                "gridsnap-ctl: no connection to the daemon over socket {path} ({error}). Is zone-daemon.py running?"
            ).format(path=path, error=exc),
            file=sys.stderr,
        )
        return EXIT_FAIL

    if not response.get("ok"):
        print(
            _("gridsnap-ctl: {error}").format(
                error=response.get("error", _("command rejected"))
            ),
            file=sys.stderr,
        )
        return EXIT_FAIL

    if not args.quiet:
        if args.raw:
            print(json.dumps(response, ensure_ascii=False))
        else:
            print(json.dumps(response, ensure_ascii=False, indent=2))
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
